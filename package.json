{
  "name": "fitexaa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-platform-admin.ts",
    "db:indexes": "tsx --env-file-if-exists=.env src/scripts/create-indexes.ts",
    "db:indexes:prod": "node dist/scripts/create-indexes.js",
    "admin:create:prod": "node dist/scripts/create-platform-admin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check src tests",
    "openapi": "tsx src/scripts/export-openapi.ts",
    "razorpay:connect": "tsx --env-file-if-exists=.env src/scripts/connect-razorpay.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mongoose": "^9.12.1",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.17.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "5.17.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "description": "Fitexaa — multi-tenant gym management platform, backend API (Express + MongoDB)",
  "engines": {
    "node": ">=22"
  }
}
