# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (Atlas or a local single-node replica set) ---
MONGODB_URI=mongodb://127.0.0.1:27017/gym_saas?replicaSet=rs0

# --- Tenancy ---
# Root domains gyms live under. Local dev uses *.localhost (e.g. powerhouse.localhost:4000).
BASE_DOMAINS=yourapp.in,localhost
# Subdomains that are never gyms (comma separated). Defaults shown.
# RESERVED_SUBDOMAINS=www,api,app,admin,platform,static,assets,mail,status
# Dev only: resolve the gym from an X-Tenant-Slug header. Must be false in production.
ALLOW_TENANT_HEADER=false
# Number of trusted proxies in front of the API (0 locally; e.g. 2 behind Cloudflare + Next.js).
TRUST_PROXY=0

# --- HTTP ---
# Browser origins allowed to call the API. Wildcard label supported.
CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Authentication ---
# Generate with: openssl rand -base64 48   (never commit the real value)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15
PASSWORD_RESET_TTL_MIN=30
INVITE_TTL_HOURS=72
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MIN=15
# Secure cookies: defaults to true in production, false otherwise.
# COOKIE_SECURE=false

# --- Links in emails (the gym's frontend app) ---
GYM_APP_URL_TEMPLATE=http://{slug}.localhost:3000

# --- Email ---
# log = print emails (with links) to the API log. Dev only; production needs a real provider (Milestone 9).
MAIL_TRANSPORT=log
MAIL_FROM=Gym App <no-reply@localhost>

# --- Scripts (optional) ---
# SEED_PASSWORD=          # password for demo accounts; generated and printed if unset
# SEED_ADMIN_EMAIL=admin@platform.demo
# ADMIN_PASSWORD=         # for npm run admin:create; generated and printed if unset
