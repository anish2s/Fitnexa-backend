# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (Atlas or a local single-node replica set) ---
MONGODB_URI=mongodb://127.0.0.1:27017/fitexaa?replicaSet=rs0

# --- Tenancy ---
# Root domains gyms live under. Local dev uses *.localhost (e.g. powerhouse.localhost:4000).
BASE_DOMAINS=yourapp.in,localhost
# Subdomains that are never gyms (comma separated). Defaults shown.
# RESERVED_SUBDOMAINS=www,api,app,admin,platform,static,assets,mail,status
# Dev only: resolve the gym from an X-Tenant-Slug header. Must be false in production.
ALLOW_TENANT_HEADER=false
# Who may set X-Forwarded-For / X-Forwarded-Host: the address(es) of the Next.js server that proxies
# to the API, e.g. "loopback" (same machine) or "10.0.0.0/8" (private network). 0 = trust nobody.
# A hop count ("1") also works locally, but production refuses it: it trusts whoever connects.
TRUST_PROXY=0

# --- HTTP ---
# Browser origins allowed to call the API. Wildcard label supported.
CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Authentication ---
# Generate with: openssl rand -base64 48   (never commit the real value)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15
PASSWORD_RESET_TTL_MIN=30
INVITE_TTL_HOURS=72
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MIN=15
# Secure cookies: defaults to true in production, false otherwise.
# COOKIE_SECURE=false

# --- Links in emails (the gym's frontend app) ---
GYM_APP_URL_TEMPLATE=http://{slug}.localhost:3000

# --- Email ---
# log = print emails (with links) to the API log. Dev only.
# resend = real delivery via Resend (required in production). Needs a domain verified in Resend;
# MAIL_FROM must use that domain. Free plan: 100 emails/day, 3,000/month.
MAIL_TRANSPORT=log
MAIL_FROM=Fitexaa <no-reply@localhost>
# Sending-only key, scoped to the sending domain. Never commit a real key.
# RESEND_API_KEY=re_...
# Kinds that may really be sent (magic_link, password_reset, invite, renewal_reminder). Others are
# skipped and logged "Email skipped: kind not enabled". Default: sign-in emails only.
# MAIL_ENABLED_KINDS=magic_link,password_reset,invite
# Outside production only: with MAIL_TRANSPORT=resend, real mail goes ONLY to these addresses;
# mail to anyone else (e.g. the seed's @member.demo) is written to the log instead. Empty = nobody.
# Must be empty in production (startup refuses otherwise).
# MAIL_ALLOWED_RECIPIENTS=you@gmail.com
# Leave RESEND_DEBUG unset: the SDK would print raw API errors, which can include the recipient.

# --- Scheduled jobs (renewal reminders); safe with several instances ---
# JOBS_ENABLED=true

# --- Attendance QR (optional; default derived from JWT_ACCESS_SECRET) ---
# QR_SIGNING_SECRET=                  # openssl rand -base64 48

# --- Online payments (Razorpay; each gym connects its own account) ---
# PAYMENTS_ENCRYPTION_KEY=            # openssl rand -base64 32; encrypts gyms' Razorpay secrets
# RAZORPAY_ALLOW_LIVE=false           # true only after the owner approves real charges

# Swagger UI at /api/docs is on outside production. In production only if this is true.
# ENABLE_API_DOCS=false

# --- Image uploads (Cloudinary). All three or none; without them uploads answer 503. ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=fitexaa-dev

# --- Scripts (optional) ---
# SEED_PASSWORD=          # password for demo accounts; generated and printed if unset
# SEED_ADMIN_EMAIL=admin@platform.demo
# ADMIN_PASSWORD=         # for npm run admin:create; generated and printed if unset
